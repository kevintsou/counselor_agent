# 軍師系統環境變數範本
# 複製成 .env 後填入實際 key：
#   cp .env.template .env
#   chmod 600 .env
#
# 注意:股票代號 / 策略門檻 / 各項數值設定不在這裡,
# 全部在 config/watchlist.json 與 config/thresholds.json(可用 MCP 工具即時修改)。

# ===== 永豐 Shioaji（報價源）=====
SHIOAJI_API_KEY=your_shioaji_api_key_here
SHIOAJI_SECRET_KEY=your_shioaji_secret_key_here
SHIOAJI_PERSON_ID=your_person_id_here            # 通常是你的身份證字號
SHIOAJI_SIMULATED=1                              # 1=模擬帳戶 / 0=真實帳戶

# ===== Claude Code Router（LLM 軍師總司令,本機代理,統一路由到 Claude）=====
# 先在本機啟動 CCR:ccr start(預設監聽 127.0.0.1:3456)
# 本專案不再直連任何 LLM 供應商 API,所有模型/供應商切換都在 CCR 設定檔處理。
CCR_BASE_URL=http://127.0.0.1:3456
CCR_API_KEY=sk-ccr-local                          # CCR 本機代理通常不驗證,填任意值即可
CCR_MODEL=claude-sonnet-4-5                        # 對應 CCR 路由規則的模型名稱

# ===== Telegram Bot（通訊兵 Herald）=====
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=8432968775                      # Kevin 的 Telegram ID

# ===== RAG 書庫（軍師呼叫時自動檢索）=====
EBOOK_DB_PATH=/Users/kjkin2006/.openclaw/workspace/ebook-library/db
